<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio Modern - Ikbal Nugraha</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

  <style>
    *{margin:0;padding:0;box-sizing:border-box;scroll-behavior:smooth}
    body{font-family:Poppins,sans-serif;background:#f8fbff;color:#1f2937}
    header{
      position:fixed;top:0;width:100%;
      display:flex;justify-content:space-between;align-items:center;
      padding:15px 8%;background:rgba(30,64,175,.95);
      color:#fff;z-index:1000
    }
    nav a{color:#fff;text-decoration:none;margin-left:20px;font-weight:500}
    nav a:hover{color:#facc15}

    section{padding:90px 8%}
    .hero{
      min-height:100vh;display:flex;align-items:center;
      justify-content:space-between;gap:30px
    }
    .hero h1{font-size:48px;color:#1e40af}
    .hero h1 span{color:#facc15}
    .hero p{margin:20px 0;color:#555}
    .btn{
      background:#facc15;color:#1f2937;padding:12px 24px;
      border-radius:30px;text-decoration:none;font-weight:600;
      transition:.3s
    }
    .btn:hover{background:#1e40af;color:#fff}

    .hero img{
      width:280px;height:280px;border-radius:50%;
      border:6px solid #1e40af;object-fit:cover
    }

    h2{text-align:center;color:#1e40af;margin-bottom:35px}

    .cards{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
      gap:20px
    }
    .card{
      background:#fff;padding:20px;border-radius:18px;
      box-shadow:0 8px 20px rgba(0,0,0,.08);
      transition:.3s
    }
    .card:hover{transform:translateY(-8px)}

    .skill-bar{
      height:10px;background:#ddd;border-radius:10px;margin-top:10px
    }
    .skill-fill{
      height:100%;background:#1e40af;border-radius:10px
    }

    footer{
      background:#1e40af;color:#fff;
      text-align:center;padding:20px
    }

    .hidden{
      opacity:0;transform:translateY(40px);
      transition:all .8s ease
    }
    .show{
      opacity:1;transform:translateY(0)
    }

    @media(max-width:768px){
      .hero{
        flex-direction:column-reverse;
        text-align:center
      }
      .hero h1{font-size:36px}
      nav{display:none}
    }
  </style>
</head>
<body>

<header>
  <h3>Ikbal.dev</h3>
  <nav>
    <a href="#about">About</a>
    <a href="#skills">Skills</a>
    <a href="#projects">Projects</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<section class="hero">
  <div>
    <h1>Halo, Saya <span>Ikbal Nugraha</span></h1>
    <p>Pelajar yang sedang belajar Web Development dengan HTML, CSS, dan JavaScript.</p>
    <a href="#projects" class="btn">Lihat Proyek</a>
  </div>

  <img src="https://via.placeholder.com/280" alt="Foto Profil">
</section>

<section id="about" class="hidden">
  <h2>Tentang Saya</h2>
  <p>Saya tertarik membuat website yang modern, responsif, dan mudah digunakan. Saya terus belajar desain UI/UX dan pengembangan web frontend.</p>
</section>

<section id="skills" class="hidden">
  <h2>Skills</h2>

  <div class="cards">
    <div class="card">
      <h3>HTML</h3>
      <div class="skill-bar"><div class="skill-fill" style="width:90%"></div></div>
    </div>

    <div class="card">
      <h3>CSS</h3>
      <div class="skill-bar"><div class="skill-fill" style="width:85%"></div></div>
    </div>

    <div class="card">
      <h3>JavaScript</h3>
      <div class="skill-bar"><div class="skill-fill" style="width:75%"></div></div>
    </div>
  </div>
</section>

<section id="projects" class="hidden">
  <h2>Proyek Saya</h2>

  <div class="cards">
    <div class="card">
      <h3>Website Portfolio</h3>
      <p>Portfolio modern dengan desain biru dan kuning.</p>
    </div>

    <div class="card">
      <h3>Landing Page</h3>
      <p>Website promosi dengan tampilan minimalis.</p>
    </div>

    <div class="card">
      <h3>UI Toko Online</h3>
      <p>Desain toko online yang responsif.</p>
    </div>
  </div>
</section>

<section id="contact" class="hidden">
  <h2>Kontak</h2>
  <p>Email: ikbal@email.com</p>
  <p>Instagram: @ikbal</p>
  <p>WhatsApp: 08xxxxxxxxxx</p>
</section>

<footer>
  © 2026 Ikbal Nugraha • Dibuat dengan HTML, CSS & JavaScript
</footer>

<script>
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add("show");
      }
    });
  });

  document.querySelectorAll(".hidden").forEach((el)=>{
    observer.observe(el);
  });
</script>

</body>
</html>
